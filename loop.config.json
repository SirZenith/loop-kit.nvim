{
    "$schema": ".pi/loop-kit/schema/loop.config.schema.json",
    "version": 1,
    "provider": "gitea",
    "loopRoot": ".pi/loop-kit",
    "tags": [
        { "name": "feature", "description": "新增功能" },
        { "name": "bugfix", "description": "缺陷修复" },
        { "name": "refactor", "description": "重构（含提取公共模式）" },
        { "name": "ux", "description": "用户体验优化" },
        { "name": "visual", "description": "视觉 / 样式调整" },
        { "name": "docs", "description": "文档" },
        { "name": "chore", "description": "构建、工具链、测试基础设施等杂项" }
    ],
    "baseURL": "https://git.dispersion.cc/api/v1",
    "repo": "Dispersion/loop-kit.nvim",
    "tokenEnv": "GITEA_API_KEY",
    "judge": {
        "baseURL": "https://opencode.ai/zen/v1/systemone",
        "model": "jev-1.13-free",
        "tokenEnv": "OPENCODE_API_KEY",
        "confidenceFloor": 0.7,
        "stateChars": 256
    },
    "isolation": {
        "verify": [
            "nvim --headless -u tests/minimal_init.lua -l tests/run.lua",
            "git diff --check"
        ]
    }
}
